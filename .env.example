# =========================
# Core Runtime
# =========================
LLM_MODEL_ID=microsoft/Phi-4-mini-instruct
HUGGINGFACE_HUB_TOKEN=
HF_LOCAL_FILES_ONLY=true

# =========================
# LLM Generation
# =========================
LLM_DEVICE=auto
LLM_PRECISION=float16
LLM_MAX_NEW_TOKENS=120
LLM_TEMPERATURE=0.4
LLM_TOP_P=0.9

# =========================
# Assistant Behavior
# =========================
SYSTEM_PROMPT=You are a concise, conversational voice assistant. Reply in 1-3 short sentences unless the user asks for detail. Do not include step-by-step reasoning unless explicitly requested.
MAX_HISTORY_TURNS=6

# =========================
# ASR (Whisper)
# =========================
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# =========================
# Auto Listening + VAD
# =========================
AUTO_STREAM=true
VAD_PROVIDER=silero
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700
VAD_PRE_SPEECH_MS=200
AUTO_STREAM_MAX_UTTERANCE_S=20

# =========================
# Audio Capture
# =========================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_SECONDS=20

# =========================
# TTS
# =========================
TTS_BACKEND=kokoro
TTS_RATE=180
TTS_VOICE_ID=
TTS_STREAMING=true
TTS_STREAM_MODE=sentence
TTS_STREAM_MIN_WORDS=4
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
